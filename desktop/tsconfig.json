{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "incremental": false,
    "module": "commonjs",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "types": ["node"],
    "outDir": "./dist",
    "rootDir": ".",
    "declaration": false,
    "sourceMap": false
  },
  "include": ["./*.ts"],
  "exclude": ["node_modules", "dist", "resources"]
}
